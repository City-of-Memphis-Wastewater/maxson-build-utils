#!/usr/bin/env bash
set -euo pipefail

# Define target directory
VENDOR_DIR="./build/vendor-packages"

echo "🧹 Cleaning up old vendor artifacts..."
rm -rf "$VENDOR_DIR"

echo "📥 Fetching dependencies safely (forcing source trees for host-binary safety)..."
# Using --no-binary :all: ensures uv downloads pure source layouts instead of 
# host-specific (macOS/Windows/Linux) pre-compiled shared objects (.so/.dylib)
uv pip install \
  backports.tarfile \
  certifi \
  chardet \
  charset_normalizer \
  idna \
  openpyxl \
  pendulum \
  requests \
  suds-py3 \
  tzdata \
  urllib3 \
  --target "$VENDOR_DIR" \
  --no-binary :all:

echo "✂️  Stripping build metadata and host binaries to optimize APK size..."
# 1. Remove .dist-info folders (dead weight inside the APK)
rm -rf "$VENDOR_DIR"/*.dist-info/

# 2. Remove script wrapper binaries generated by pip/uv
rm -rf "$VENDOR_DIR"/bin/

# 3. Fail-safe: Double check if any native host libraries accidentally slipped through
if ls "$VENDOR_DIR"/*.so "$VENDOR_DIR"/*.dylib >/dev/null 2>&1; then
    echo "⚠️ Warning: Native host libraries found in vendor folder! Removing them to prevent Android runtime crashes."
    rm -f "$VENDOR_DIR"/*.so "$VENDOR_DIR"/*.dylib
fi

echo "🚀 Navigating to Buildozer packaging workspace..."
# Run from packaging/kivy directory
cd "$(dirname "$0")/../packaging/buildozer"

echo "🤖 Compiling Android debug APK..."
uv run buildozer android debug
